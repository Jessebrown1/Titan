# ─── Supabase (required for live inventory, enquiries and /admin) ───
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Company contact details (leave blank until confirmed) ───
# Phone in international format, e.g. +233 24 123 4567
VITE_COMPANY_PHONE=
# WhatsApp number in international format (leave blank to use the phone number)
VITE_COMPANY_WHATSAPP=
VITE_COMPANY_EMAIL=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_HOURS=

# ─── Social links (optional) ───
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=
VITE_SOCIAL_YOUTUBE=

# ─── Locale ───
VITE_CURRENCY=GHS
VITE_LOCALE=en-GH
# "mi" or "km"
VITE_DISTANCE_UNIT=km

# Public site URL (used for SEO canonical / Open Graph)
VITE_SITE_URL=
