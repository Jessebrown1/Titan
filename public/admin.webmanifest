{
  "id": "/admin",
  "name": "TITAN MOTORS Admin",
  "short_name": "TITAN Admin",
  "description": "Manage vehicles, rentals and enquiries for TITAN MOTORS.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0b",
  "theme_color": "#0a0a0b",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Add vehicle", "url": "/admin/vehicles/new", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rentals", "url": "/admin/rentals", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Enquiries", "url": "/admin/enquiries", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
